#!/usr/bin/env bash
# =============================================================================
# Qwen3.8-27B 训练档案
#   model_type=qwen3_5 / template=qwen3_8 / Qwen3_5ForConditionalGeneration
#   64 层、hidden 5120、GDN 线性注意力 : full_attention = 3:1、ViT + MTP
#   bf16 权重 51.75 GiB（18 shards），本机 D:\model\qwen 已完整存在
#   官方支持表：Support Megatron = ✔，依赖 transformers>=5.2（最佳实践建议 >=5.9）
# =============================================================================
export MODEL_KEY="qwen38_27b"
export MODEL_ID="Qwen/Qwen3.8-27B"
export MODEL_PATH="$MODEL_27B_DIR"
export MANIFEST="$PROJECT_ROOT/manifests/qwen3_8_27b.json"
export MODEL_TYPE="qwen3_5"
export TEMPLATE="qwen3_8"
export ARCHITECTURE="Qwen3_5ForConditionalGeneration"
export IS_MOE=0

# 显存估算用（03 据此做全参可行性预检）
# 28.7B 总参 = TP4 下每 rank 7.19B × 4；其中 ViT 视觉塔约 1.8B 被冻结（freeze_vit）。
export MODEL_TOTAL_PARAMS_B="${MODEL_TOTAL_PARAMS_B:-29}"
export MODEL_FROZEN_PARAMS_B="${MODEL_FROZEN_PARAMS_B:-2}"

# 并行策略：8 卡 H200 下 TP4 / PP1 / DP2（world_size=8）。
# TP 不跨节点；若 4 卡机器改 TP=4 & NPROC_PER_NODE=4，若 16 卡可 TP4/PP1/DP4。
export TP="${TP:-4}"
export PP="${PP:-1}"
export EP="${EP:-1}"
export ETP="${ETP:-1}"
export CP="${CP:-1}"
export SP="${SP:-true}"

# 训练超参（基线来自官方 examples/megatron/pretrain.sh）
export MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-1}"
export GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-16}"
export MAX_LENGTH="${MAX_LENGTH:-8192}"
export TRAIN_ITERS="${TRAIN_ITERS:-100}"
export LR="${LR:-1e-5}"
export MIN_LR="${MIN_LR:-1e-6}"
export LR_WARMUP_ITERS="${LR_WARMUP_ITERS:-30}"
export SAVE_STEPS="${SAVE_STEPS:-50}"
export RECOMPUTE_GRANULARITY="${RECOMPUTE_GRANULARITY:-full}"
export RECOMPUTE_METHOD="${RECOMPUTE_METHOD:-uniform}"
export RECOMPUTE_NUM_LAYERS="${RECOMPUTE_NUM_LAYERS:-1}"
export TUNER_TYPE="${TUNER_TYPE:-full}"
export STREAMING="${STREAMING:-true}"
export PACKING="${PACKING:-true}"
export ATTENTION_BACKEND="${ATTENTION_BACKEND:-flash}"
export FINETUNE="${FINETUNE:-true}"
export NO_SAVE_OPTIM="${NO_SAVE_OPTIM:-true}"

# 模型专属附加参数（空格分隔字符串，03_continue_pt.sh 会拆成 argv）
export MOE_ARGS="${MOE_ARGS:-}"
export EXTRA_ARGS="${EXTRA_ARGS:-}"
export PLE_CPU_OFFLOAD="${PLE_CPU_OFFLOAD:-0}"
