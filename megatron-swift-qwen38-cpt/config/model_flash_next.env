#!/usr/bin/env bash
# =============================================================================
# Qwen3.8-Flash-Next 训练档案
#   model_type=qwen4_exp / template=qwen3_8 / Qwen4ExpForConditionalGeneration
#   125B 总参 / ~6B 激活，512 experts × top-10，48 层，hidden 2560，
#   GDN + QSA(indexer_budget 2048) + Gated Residual(HC=4) + 51B N-gram 表 + MTP + ViT
#   bf16 权重 335.28 GiB（131 shards）
#   官方支持表：Support Megatron = ✔，依赖 transformers>=5.16
#
# 【默认全参数 CPT】参数拆解与显存账：
#    125B 总参 − 51B N-gram 表（PLE，bf16 ≈ 95 GiB，默认冻结并 CPU 卸载）
#    = 约 74B 可训练
#    bf16 权重 148 GB + bf16 梯度 148 GB + fp32 主权重&Adam(m,v) 888 GB
#    ≈ 1184 GB 训练状态（不含 activation）
#
#   **单机 8×H200 只有 1150 GB，必然放不下**。最优切分（PP=1/DP=8）仍需
#   每卡约 259 GB。所以本档案默认打开 OPTIMIZER_CPU_OFFLOAD，把 888 GB 优化器
#   状态挪到主机内存（另需约 0.9 TB DRAM），GPU 只留权重+梯度+activation。
#   若主机内存也不够，只能扩到 2 节点（16 卡）或退回 LoRA：
#       TUNER_TYPE=lora bash scripts/12_run_in_container.sh scripts/03_continue_pt.sh flash_next
# =============================================================================
export MODEL_KEY="qwen38_flash_next"
export MODEL_ID="Qwen/Qwen3.8-Flash-Next"
export MODEL_PATH="$MODEL_FLASH_NEXT_DIR"
export MANIFEST="$PROJECT_ROOT/manifests/qwen3_8_flash_next.json"
export MODEL_TYPE="qwen4_exp"
export TEMPLATE="qwen3_8"
export ARCHITECTURE="Qwen4ExpForConditionalGeneration"
export IS_MOE=1

# 显存估算用（03 据此做全参可行性预检，改模型时一并改这里）
export MODEL_TOTAL_PARAMS_B="${MODEL_TOTAL_PARAMS_B:-125}"    # 十亿参数
export MODEL_FROZEN_PARAMS_B="${MODEL_FROZEN_PARAMS_B:-51}"   # 冻结的 N-gram 表
export MODEL_WEIGHT_BYTES_GB="${MODEL_WEIGHT_BYTES_GB:-335}"  # bf16 落盘体积

# --- 并行（全参） -----------------------------------------------------------
# MoE 模型 TP 效率低（专家内部本来就不按 TP 切），所以 TP 压到 1，把参数摊到
# PP 与 DP 上。DP 随节点数自动变，EP 必须 ≤ DP 且能整除 DP：
#
#   单机 8 卡   (NNODES=1)  DP=8/(1×4)=2  → EP=2      权重+梯度 74 GB/卡
#   2 节点 16 卡(NNODES=2)  DP=16/(1×4)=4 → EP=4 更均衡 权重+梯度 74 GB/卡
#   4 节点 32 卡(NNODES=4)  DP=32/(1×4)=8 → EP=8        权重+梯度 74 GB/卡
#
# PP=4 时 48 层/4 段 = 12 层/段，与 --decoder_first_pipeline_num_layers 12 对齐。
# **无论几个节点都建议保留 OPTIMIZER_CPU_OFFLOAD=1**：不开的话 888 GB 优化器状态
# 要按 DP 分片，16 卡时每卡仍需 222 GB，远超单卡 143.7 GB；要到 64 卡以上才够。
export TP="${TP:-1}"
export PP="${PP:-4}"
export EP="${EP:-2}"       # 2 节点以上建议 EP=4，随 DP 一起放大
export ETP="${ETP:-1}"
export CP="${CP:-1}"
# sequence_parallel 依赖 TP>1，TP=1 时必须关闭，否则 Megatron 直接 assert
if (( ${TP:-1} > 1 )); then
  export SP="${SP:-true}"
else
  export SP="${SP:-false}"
fi

export MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-1}"
export GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-8}"
export MAX_LENGTH="${MAX_LENGTH:-8192}"
export TRAIN_ITERS="${TRAIN_ITERS:-100}"
export LR="${LR:-1e-5}"
export MIN_LR="${MIN_LR:-1e-6}"
export LR_WARMUP_ITERS="${LR_WARMUP_ITERS:-30}"
export SAVE_STEPS="${SAVE_STEPS:-50}"
export RECOMPUTE_GRANULARITY="${RECOMPUTE_GRANULARITY:-full}"
export RECOMPUTE_METHOD="${RECOMPUTE_METHOD:-uniform}"
export RECOMPUTE_NUM_LAYERS="${RECOMPUTE_NUM_LAYERS:-1}"
export TUNER_TYPE="${TUNER_TYPE:-full}"
export STREAMING="${STREAMING:-true}"
export PACKING="${PACKING:-true}"
export ATTENTION_BACKEND="${ATTENTION_BACKEND:-flash}"
export FINETUNE="${FINETUNE:-true}"
export NO_SAVE_OPTIM="${NO_SAVE_OPTIM:-true}"

# --- 全参必需的显存缓解 -----------------------------------------------------
# 888 GB 优化器状态留在 GPU 上必然 OOM，默认卸载到主机内存。
# 代价：每步在 CPU/GPU 间搬运，吞吐会显著低于 LoRA，属正常现象。
export OPTIMIZER_CPU_OFFLOAD="${OPTIMIZER_CPU_OFFLOAD:-1}"
# PLE(N-gram) 表 bf16 约 95 GiB，只能沿 TP 切分；TP=1 时整表落单卡，必须卸载。
# 注意：开启后该表被冻结，全参训练时这部分权重不参与更新（属于设计如此）。
export PLE_CPU_OFFLOAD="${PLE_CPU_OFFLOAD:-1}"

# --- LoRA 备选（TUNER_TYPE=lora 时才生效） ----------------------------------
# 官方最佳实践只给 8 卡 LoRA 配置，显存不够时的退路。
export LORA_RANK="${LORA_RANK:-8}"
export LORA_ALPHA="${LORA_ALPHA:-32}"
export LORA_TARGET="${LORA_TARGET:-in_proj out_proj linear_proj linear_qkv}"

# 注意：ETP 由 03 按 --expert_tensor_parallel_size 统一传，这里不要再写一遍
# （重复传参会以后者为准，容易误判实际生效值）。
export MOE_ARGS="${MOE_ARGS:---moe_permute_fusion true --decoder_first_pipeline_num_layers 12}"
export EXTRA_ARGS="${EXTRA_ARGS:-}"
