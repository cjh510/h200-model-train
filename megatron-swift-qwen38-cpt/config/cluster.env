#!/usr/bin/env bash
# =============================================================================
# 【现场配置】所有需要你指定的值集中在这里，改这一个文件即可。
#
# 加载方：scripts/lib.sh **最先加载**（早于 env.sh / image.env）。
# 因为 env.sh / image.env 全部用 ${VAR:-default}，本文件先设置的值会被保留，
# 从而实现「现场配置优先」。12/13 自动继承，无需重复 source；
# 12 会把这些值透传进容器，容器内 env.sh 同样用 ${VAR:-...} 保留。
#
# 用法（可编辑本文件，也可在命令行用同名环境变量覆盖）：
#   MODEL_ROOT=/data/models NNODES=2 NODE_IPS=192.0.2.21,192.0.2.22 \
#     MASTER_ADDR=192.0.2.21 bash scripts/13_multinode.sh scripts/03_continue_pt.sh 27b
# =============================================================================

# --- 1) 镜像 -----------------------------------------------------------------
# 官方 ms-swift v4.5.3 镜像，已在各节点拉取，运行时不构建派生镜像。
# 换成其他镜像时注意：必须 >= v4.5.3，否则 T0 探针（qwen3_8 / qwen4_exp）
# 会直接判 UNSUPPORTED 并中止。
export RUN_IMAGE="${RUN_IMAGE:-modelscope-registry.cn-beijing.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-cuda13.0.3-py312-torch2.13.0-vllm0.28.0-modelscope1.40.0-swift4.5.3}"
export SKIP_PULL="${SKIP_PULL:-1}"     # 1 = 镜像已在各节点，跳过 pull 检查

# --- 2) 模型权重路径（你指定） -----------------------------------------------
export MODEL_ROOT="${MODEL_ROOT:-/data/Qwen3.8-27B}"
export MODEL_27B_DIR="${MODEL_27B_DIR:-$MODEL_ROOT/Qwen3.8-27B}"
export MODEL_FLASH_NEXT_DIR="${MODEL_FLASH_NEXT_DIR:-$MODEL_ROOT/Qwen3.8-Flash-Next}"

# --- 3) 缓存 / 产物（多机必须是共享存储） -----------------------------------
export MODELSCOPE_CACHE="${MODELSCOPE_CACHE:-/mnt/shared/modelscope_cache}"

# --- 4) GPU 拓扑（你指定：台数、每节点卡数） ---------------------------------
export GPUS_PER_NODE="${GPUS_PER_NODE:-8}"
export NPROC_PER_NODE="${NPROC_PER_NODE:-$GPUS_PER_NODE}"
export NNODES="${NNODES:-1}"
export NODE_RANK="${NODE_RANK:-0}"
export MASTER_ADDR="${MASTER_ADDR:-192.0.2.10}"
export MASTER_PORT="${MASTER_PORT:-29500}"

# 按 GPUS_PER_NODE 生成 CUDA_VISIBLE_DEVICES。
# env.sh 的默认 8 卡串在 GPUS_PER_NODE 改小后必须重新生成；
# 用户显式设置的非默认串（如 "0,1,2,3"）始终保留。
_default_devs="0,1,2,3,4,5,6,7"
if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]] ||
   { [[ "$CUDA_VISIBLE_DEVICES" == "$_default_devs" ]] && [[ "$GPUS_PER_NODE" != "8" ]]; }; then
  _devs=""
  for ((_i = 0; _i < GPUS_PER_NODE; _i++)); do
    _devs+="${_devs:+,}$_i"
  done
  export CUDA_VISIBLE_DEVICES="$_devs"
  unset _devs _i
fi
unset _default_devs

# --- 5) 多机节点（你指定：IP；顺序即 NODE_RANK） ----------------------------
export NODE_IPS="${NODE_IPS:-}"                 # 例：192.0.2.21,192.0.2.22
export SSH_USER="${SSH_USER:-root}"
export SSH_OPTS="${SSH_OPTS:--o StrictHostKeyChecking=no -o ConnectTimeout=10}"
export PROJECT_REMOTE_DIR="${PROJECT_REMOTE_DIR:-/root/megatron-swift-qwen38-cpt}"
# 注意：PROJECT_HOST 不在这里设置。12 在该目录里被启动时，
# config/image.env 会按脚本位置自动把它推断成同一路径，避免双重来源。

# --- 6) 容器引擎（固定 nerdctl） ---------------------------------------------
export CONTAINER_ENGINE="${CONTAINER_ENGINE:-nerdctl}"
export CONTAINER_NAMESPACE="${CONTAINER_NAMESPACE:-default}"
