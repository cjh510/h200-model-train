#!/usr/bin/env bash
# =============================================================================
# 镜像与容器配置
#
# 使用官方 ms-swift v4.5.3 镜像，已由用户在集群各节点拉取，运行时不再构建任何
# 派生镜像。
#
# 版本依据：v4.5.3（2026-09-07）是首个包含 Qwen3.8 支持代码的正式版本
#   · 模型发布：Qwen3.8-27B(2026-08-13)、Qwen3.8-Flash-Next(2026-08-26)
#   · v4.4.1(2026-07-13) / v4.4.3(2026-08-03) 源码树中
#     qwen3_8 / qwen4_exp 关键词计数均为 0，无法训练这两个模型
# 镜像内已含：torch2.13 / vllm0.28 / modelscope1.40 / swift4.5.3 / megatron-core
# =============================================================================

export OFFICIAL_453_IMAGE="${OFFICIAL_453_IMAGE:-modelscope-registry.cn-beijing.cr.aliyuncs.com/modelscope-repo/modelscope:ubuntu22.04-cuda13.0.3-py312-torch2.13.0-vllm0.28.0-modelscope1.40.0-swift4.5.3}"

# 所有运行/探针脚本默认使用的镜像。cluster.env 会把它设为同一个值，
# 也可在命令行用 IMAGE=... / PROBE_IMAGE=... 单独覆盖。
export RUN_IMAGE="${RUN_IMAGE:-$OFFICIAL_453_IMAGE}"
export SKIP_PULL="${SKIP_PULL:-1}"          # 镜像已拉取，跳过 pull 检查

# 容器引擎：现场固定 nerdctl + --namespace default（load/run/images 必须一致）
export CONTAINER_ENGINE="${CONTAINER_ENGINE:-nerdctl}"      # nerdctl | docker
export CONTAINER_NAMESPACE="${CONTAINER_NAMESPACE:-default}"
export CONTAINER_NAME="${CONTAINER_NAME:-qwen38-cpt}"

# 容器内路径。PROJECT_ROOT 由 config/env.sh 在容器内按脚本位置自动推断。
export PROJECT_HOST="${PROJECT_HOST:-$PROJECT_ROOT}"
export PROJECT_IN="${PROJECT_IN:-/workspace/qwen38-cpt}"

# 把宿主目录 bind 回容器「相同路径」：现场踩过坑——容器看不到 /mnt/shared/...，
# 导致 dataset cache / 权重读不到。
export MODEL_ROOT_BIND="${MODEL_ROOT_BIND:-1}"
export CACHE_BIND="${CACHE_BIND:-1}"
export CONTAINER_EXTRA_MOUNTS="${CONTAINER_EXTRA_MOUNTS:-}"   # 例："-v /pfs/x:/pfs/x"
export CONTAINER_GPUS="${CONTAINER_GPUS:-all}"
export CONTAINER_SHM="${CONTAINER_SHM:-64g}"
